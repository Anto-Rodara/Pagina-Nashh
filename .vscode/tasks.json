{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sincronización automática con GitHub",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\auto-sync.ps1"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "auto-sync",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[.*\\] Iniciando sincronización automática",
          "endsPattern": "^\\[.*\\] Sincronización automática activa\\."
        }
      },
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
